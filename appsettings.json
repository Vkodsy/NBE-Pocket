{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=UserAuthDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Jwt": {
    "Key": "REPLACE-IN-USER-SECRETS",
    "Issuer": "UserAuthApi",
    "Audience": "UserAuthClient",
    "ExpiresInMinutes": 60
  },

  "AllowedHosts": "*",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
